# ---------- 运行环境 ----------
NODE_ENV=production

# ---------- PostgreSQL ----------
# 地址和凭据必须与数据库服务器的 .env.production 一致。
DATABASE_URL=postgresql://cees:change_me@change_me:5432/cees_ai?schema=public

# ---------- 钉钉 ----------
DINGTALK_API_BASE_URL=https://oapi.dingtalk.com
DINGTALK_CREDENTIAL_ENCRYPTION_KEY=change_me

# ---------- GitHub OAuth ----------
# Client ID / Secret 由 API 部署环境持有；不要提交真实值。
CEES_GITHUB_OAUTH_CLIENT_ID=change_me
CEES_GITHUB_OAUTH_CLIENT_SECRET=change_me

# ---------- Redis ----------
REDIS_URL=redis://:change_me@change_me:6379/0
REDIS_KEY_PREFIX=cees:production:

# ---------- 腾讯云 COS ----------
# Bucket 名称格式通常为 <bucket-name>-<appid>。
# 生产环境请使用仅授予目标 Bucket 必要权限的 CAM 子账号或角色凭据。
TENCENT_COS_SECRET_ID=change_me
TENCENT_COS_SECRET_KEY=change_me
TENCENT_COS_REGION=ap-chengdu
TENCENT_COS_BUCKET=cees-ai-1403013862
TENCENT_COS_OBJECT_PREFIX=cees/production
TENCENT_COS_SIGNED_URL_TTL_SECONDS=600
TENCENT_COS_UPLOAD_MAX_BYTES=104857600

# ---------- JWT 与会话 ----------
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PLATFORM_ACCESS_SECRET=change_me
JWT_PLATFORM_ACCESS_TTL=15m
JWT_PLATFORM_REFRESH_TTL=30d
TENANT_INVITATION_TTL=1d

# ---------- 初始化数据 ----------
# 首次成功执行 Prisma migration 后创建；已存在时不会覆盖密码或状态。
SEED_PLATFORM_ADMIN_ACCOUNT=superadmin
SEED_PLATFORM_ADMIN_PASSWORD=change_me
SEED_PLATFORM_ADMIN_DISPLAY_NAME=Platform Administrator

# ---------- 联网搜索 ----------
# 当前仅支持 Tavily；实际密钥通过平台 Secrets 注入。
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=change_me
WEB_SEARCH_TIMEOUT_MS=15000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_SNIPPET_CHARS=1500
# 检索深度：advanced 会抓取页面正文片段（2 credit/次），basic 只取摘要（1 credit/次）。
# 销量、产量、财务这类需要具体数字的查询建议保留 advanced。
WEB_SEARCH_SEARCH_DEPTH=advanced

# ---------- AI 服务 ----------
AI_SERVICE_URL=http://ai-service:8000
AI_INTERNAL_TOKEN=change_me
AI_DOCS_ENABLED=false

# ---------- 模型目录与密钥 ----------
AI_MODEL_CONFIG_PATH=/run/config/ai-models.toml
AI_MODEL_CONFIG_HOST_PATH=../config/models.production.toml
# 文本/工具链路：主模型 + qwen 跨厂商备用（同一角色下按顺序回退）。
PRIMARY_LLM_API_KEY=change_me
QWEN_API_KEY=change_me
# 图片生成与编辑（独立于聊天视觉模型）。
IMAGE_GEN_API_KEY=change_me
IMAGE_GEN_BACKUP_API_KEY=change_me
# 聊天图片理解：vision-primary + vision-backup。
VISION_LLM_API_KEY=change_me
# 知识库向量：EMBEDDING_BACKUP_API_KEY 只在启用备用 embedding profile 时才需要。
EMBEDDING_API_KEY=change_me
EMBEDDING_BACKUP_API_KEY=change_me

# ---------- 知识库向量库 ----------
# pgvector 使用同一 PostgreSQL 实例的独立库（部署前需手动创建）。
# 维度必须与 ai-service 模型目录中 embedding profile 声明的 dimension 一致。
KNOWLEDGE_VECTOR_STORE=pgvector
KNOWLEDGE_VECTOR_DATABASE_URL=postgresql://cees:change_me@change_me:5432/cees_ai_vectors
KNOWLEDGE_VECTOR_DIMENSION=1536
# 索引/查询共用的 embedding profile，必须是 ai-service 模型目录中已启用的 profile。
KNOWLEDGE_EMBEDDING_PROFILE=primary

# ---------- MinerU 文档解析 ----------
# 宿主机常驻 mineru-api（端口 8002，与 ai-service 的 8000 错开）；未配置时文档置 FAILED。
MINERU_API_URL=change_me
MINERU_API_TIMEOUT_MS=1800000
MINERU_API_LANG_LIST=ch

# ---------- 容器与端口 ----------
API_IMAGE=cees-api
AI_SERVICE_IMAGE=cees-ai-service
IMAGE_TAG=production
API_PORT=3000

# ---------- 客户端地址 ----------
DESKTOP_API_URL=https://www.cees.top/api/v1
MOBILE_API_URL=https://app.cees.top/api/v1
