{
    "name": "@cees/desktop",
    "version": "0.1.3",
    "private": true,
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "tsc -p electron/tsconfig.json && concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
        "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
        "icons": "node scripts/generate-icons.cjs",
        "test:dws": "tsc -p electron/tsconfig.json && node --test tests/dingtalk-dws.test.cjs tests/dingtalk-connector.test.cjs tests/connector-runtime.test.cjs tests/local-cli-transport.test.cjs tests/http-api-transport.test.cjs tests/remote-mcp-transport.test.cjs tests/remote-mcp-host.test.cjs tests/tencent-meeting-connector.test.cjs tests/wecom-connector.test.cjs tests/github-connector.test.cjs tests/local-disk-scanner.test.cjs tests/local-cleanup-manager.test.cjs tests/local-file-saver.test.cjs",
        "dist:win": "pnpm icons && pnpm build && electron-builder --win nsis zip --x64",
        "dist:mac": "pnpm build && electron-builder --mac dmg zip"
    },
    "build": {
        "appId": "com.cees.ai.desktop",
        "productName": "CEES AI",
        "asar": true,
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "dist-electron/**/*",
            "mcp.json",
            "package.json"
        ],
        "artifactName": "CEES-AI-${version}-${arch}.${ext}",
        "win": {
            "executableName": "CEES-AI",
            "icon": "build/icons/cees.ico",
            "signtoolOptions": {
                "certificateSha1": "7D2CDB58F3E8FEA8FA60A508E54F703CC591341E",
                "signingHashAlgorithms": [
                    "sha256"
                ],
                "rfc3161TimeStampServer": "http://timestamp.digicert.com"
            },
            "target": [
                "nsis",
                "zip"
            ]
        },
        "mac": {
            "category": "public.app-category.business",
            "target": [
                "dmg",
                "zip"
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true
        },
        "publish": {
            "provider": "generic",
            "url": "https://cdn.cees.top/desktop/"
        }
    },
    "dependencies": {
        "@ant-design/icons": "^5.5.2",
        "@modelcontextprotocol/sdk": "1.30.1",
        "@tanstack/react-query": "^5.62.11",
        "antd": "^5.22.6",
        "echarts": "^5.5.1",
        "electron-updater": "^6.8.9",
        "lucide-react": "^1.45.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-markdown": "^10.1.0",
        "react-router-dom": "^7.1.1",
        "remark-gfm": "^4.0.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@types/node": "^22.10.5",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "concurrently": "^9.1.2",
        "electron": "^44.3.0",
        "electron-builder": "^26.15.3",
        "sharp": "^0.35.5",
        "typescript": "^5.7.2",
        "vite": "^6.0.7",
        "wait-on": "^8.0.1"
    }
}