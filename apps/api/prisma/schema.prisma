generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
}

enum PlatformRole {
  SUPER_ADMIN
}

enum PlatformAdministratorStatus {
  ACTIVE
  DISABLED
}

enum TenantInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum MembershipStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum DepartmentStatus {
  ACTIVE
  DISABLED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum ResourceType {
  DOCUMENT
  IMAGE
}

enum AclSubjectType {
  MEMBERSHIP
  ROLE
}

enum DocumentVisibility {
  PRIVATE
  TENANT
}

enum VisibilityScope {
  PRIVATE
  DEPARTMENT
  PROJECT
  TENANT
  CUSTOM
}

enum KnowledgeDocumentStatus {
  PENDING
  PARSING
  PARSED
  INDEXING
  READY
  FAILED
}

/// 转存来源锚定类型（块 7c）：附件文件 / AI 生成文档 / 对话消息；人工上传文档为空。
enum KnowledgeDocumentSourceType {
  FILE_OBJECT
  DOCUMENT
  MESSAGE
}

enum DataScope {
  SELF
  DEPARTMENT
  DEPARTMENT_TREE
  PROJECT
  CUSTOM
  TENANT
}

enum AssignmentPolicyDomain {
  TASK
  MEETING
  WORK_REPORT
  PROJECT
  DOCUMENT
}

enum AssignmentPolicyLevel {
  TENANT
  PROJECT
}

enum AssignmentPolicyFallbackMode {
  NONE
  PROJECT_MEMBERS
  TENANT_MEMBERS
}

enum HrProfileStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  ON_LEAVE
}

enum HrLeaveUnit {
  DAY
  HALF_DAY
  HOUR
}

enum HrLeaveRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HrAttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  ABSENT
  LEAVE
  OVERTIME
  EXCEPTION
  CORRECTED
}

enum HrAttendanceSource {
  MANUAL
  IMPORT
  DINGTALK
}

enum HrOvertimeRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum HrEmployeeChangeType {
  ONBOARD
  PROBATION
  TRANSFER
  PROMOTION
  DEMOTION
  RESIGNATION
  TERMINATION
}

enum HrEmployeeChangeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  EFFECTIVE
}

enum FinanceExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  CANCELLED
  PAID
}

enum FinancePaymentMethod {
  BANK_TRANSFER
  CASH
  CORPORATE_CARD
  OTHER
}

enum LegalContractStatus {
  DRAFT
  ACTIVE
  PENDING_RENEWAL
  EXPIRED
  TERMINATED
  ARCHIVED
}

enum LegalContractType {
  PURCHASE
  SALES
  SERVICE
  EMPLOYMENT
  NDA
  LEASE
  OTHER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskAssigneeType {
  OWNER
  COLLABORATOR
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectMemberRole {
  OWNER
  MANAGER
  MEMBER
}

enum MeetingStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum MeetingParticipantRole {
  HOST
  RECORDER
  PARTICIPANT
}

enum MeetingResponseStatus {
  INVITED
  ACCEPTED
  DECLINED
  TENTATIVE
}

enum MeetingAttendanceStatus {
  PENDING
  ATTENDED
  ABSENT
}

enum MeetingMinutesStatus {
  DRAFT
  PUBLISHED
}

enum WorkReportType {
  DAILY
  WEEKLY
}

enum WorkReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum DraftStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum FilePurpose {
  ATTACHMENT
  /// AI 图片生成结果正式文件。
  GENERATED_IMAGE
  /// AI 文档生成结果正式文件（DOCX/PDF/PPTX）。
  GENERATED_DOCUMENT
}

enum UploadSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED
}

/// 会话可见性；当前仅支持成员私有，为后续共享能力预留。
enum ConversationVisibility {
  PRIVATE
}

/// 服务端持久化的会话消息角色；TOOL 为工具结果消息，工具阶段启用。
enum ConversationMessageRole {
  USER
  ASSISTANT
  TOOL
}

/// Assistant 轮次状态机；由 NestJS TurnRunner 驱动。
enum AssistantTurnStatus {
  RECEIVED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// Assistant 轮次当前持久化检查点；用于观测、超时判断和进程重启后的保守恢复。
enum AssistantTurnStage {
  QUEUED
  MODEL_CALL
  TOOL_EXECUTION
  FINALIZING
}

/// 轮次事件类型；与公开 TurnStreamEvent 联合一一对应。
enum AssistantEventType {
  STARTED
  STATUS
  CONTENT_DELTA
  TOOL_CALL
  TOOL_RESULT
  USAGE
  COMPLETED
  ERROR
  /// 基于本轮答复生成的追问建议；在 COMPLETED 之后异步到达。
  RELATED_QUESTIONS
}

/// 工具调用生命周期：程序化批准结论与执行结果。
enum ToolCallStatus {
  /// 模型已提出，尚未完成执行前批准。
  PROPOSED
  /// 批准通过，等待执行。
  APPROVED
  EXECUTING
  COMPLETED
  FAILED
  /// 批准拒绝（未知工具 / 无权限 / 参数非法 / 额度不足）。
  REJECTED
  /// 执行进程在外部副作用期间丢失，禁止自动重放，等待人工或专用恢复器处理。
  RECOVERY_REQUIRED
}

/// AI 图片从预留资源到可访问资源的持久化状态。
enum ManagedImageStatus {
  PENDING
  GENERATING
  UPLOADING
  READY
  FAILED
  ORPHANED
}

enum DingTalkIntegrationStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum DingTalkSyncJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum DingTalkSyncType {
  FULL_ORGANIZATION
}

model Tenant {
  id                        String                         @id @default(uuid()) @db.Uuid
  code                      String                         @unique
  name                      String
  timezone                  String                         @default("Asia/Shanghai")
  status                    TenantStatus                   @default(ACTIVE)
  memberships               TenantMembership[]
  authSessions              AuthSession[]
  departments               Department[]
  roles                     Role[]
  membershipRoles           MembershipRole[]
  rolePermissions           RolePermission[]
  resources                 Resource[]
  managedDocuments          ManagedDocument[]
  managedImages             ManagedImage[]
  resourceAcls              ResourceAcl[]
  invitations               TenantInvitation[]
  projects                  Project[]
  assignmentPolicies        AssignmentPolicy[]
  hrProfiles                HrProfile[]
  hrLeaveTypes              HrLeaveType[]
  hrLeaveBalances           HrLeaveBalance[]
  hrLeaveRequests           HrLeaveRequest[]
  hrAttendanceRecords       HrAttendanceRecord[]
  hrOvertimeRequests        HrOvertimeRequest[]
  hrEmployeeChanges         HrEmployeeChange[]
  financeExpenseCategories  FinanceExpenseCategory[]
  financeExpenseReports     FinanceExpenseReport[]
  financeExpenseItems       FinanceExpenseItem[]
  financeExpenseAttachments FinanceExpenseAttachment[]
  financeExpenseHistories   FinanceExpenseStatusHistory[]
  financeExpenseSequences   FinanceExpenseReportSequence[]
  legalContracts            LegalContract[]
  legalContractAttachments  LegalContractAttachment[]
  legalContractHistories    LegalContractStatusHistory[]
  legalContractSequences    LegalContractSequence[]
  projectCodeSequences      ProjectCodeSequence[]
  projectMembers            ProjectMember[]
  projectStatusHistory      ProjectStatusHistory[]
  tasks                     Task[]
  taskAssignees             TaskAssignee[]
  taskComments              TaskComment[]
  taskAttachments           TaskAttachment[]
  taskActivities            TaskActivity[]
  meetings                  Meeting[]
  meetingParticipants       MeetingParticipant[]
  meetingMinutes            MeetingMinutes[]
  workReports               WorkReport[]
  workReportProjects        WorkReportProject[]
  workReportTasks           WorkReportTask[]
  notifications             Notification[]
  notificationRecipients    NotificationRecipient[]
  dingTalkIntegration       DingTalkIntegration?
  dingTalkDepartments       DingTalkDepartment[]
  dingTalkUsers             DingTalkUser[]
  dingTalkSyncJobs          DingTalkSyncJob[]
  createdAt                 DateTime                       @default(now()) @map("created_at")
  updatedAt                 DateTime                       @updatedAt @map("updated_at")
  deletedAt                 DateTime?                      @map("deleted_at")
  version                   Int                            @default(1)

  @@map("tenants")
}

model User {
  id                        String                  @id @default(uuid()) @db.Uuid
  email                     String?
  normalizedEmail           String?                 @unique @map("normalized_email")
  passwordHash              String?                 @map("password_hash")
  displayName               String                  @map("display_name")
  status                    UserStatus              @default(ACTIVE)
  failedLoginCount          Int                     @default(0) @map("failed_login_count")
  lockedUntil               DateTime?               @map("locked_until")
  lastLoginAt               DateTime?               @map("last_login_at")
  memberships               TenantMembership[]
  authSessions              AuthSession[]
  platformAdministrator     PlatformAdministrator?
  platformAuthSessions      PlatformAuthSession[]
  acceptedTenantInvitations TenantInvitation[]      @relation("AcceptedTenantInvitations")
  notificationRecipients    NotificationRecipient[]
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")
  createdBy                 String?                 @map("created_by") @db.Uuid
  updatedBy                 String?                 @map("updated_by") @db.Uuid
  deletedAt                 DateTime?               @map("deleted_at")
  version                   Int                     @default(1)

  @@map("users")
}

model TenantMembership {
  id                      String                        @id @default(uuid()) @db.Uuid
  tenantId                String                        @map("tenant_id") @db.Uuid
  tenant                  Tenant                        @relation(fields: [tenantId], references: [id])
  userId                  String                        @map("user_id") @db.Uuid
  user                    User                          @relation(fields: [userId], references: [id])
  departmentId            String?                       @map("department_id") @db.Uuid
  department              Department?                   @relation(fields: [departmentId], references: [id])
  displayName             String?                       @map("display_name")
  account                 String
  normalizedAccount       String                        @map("normalized_account")
  passwordHash            String?                       @map("password_hash")
  status                  MembershipStatus              @default(ACTIVE)
  failedLoginCount        Int                           @default(0) @map("failed_login_count")
  lockedUntil             DateTime?                     @map("locked_until")
  lastLoginAt             DateTime?                     @map("last_login_at")
  joinedAt                DateTime                      @default(now()) @map("joined_at")
  authSessions            AuthSession[]
  membershipRoles         MembershipRole[]
  ownedResources          Resource[]
  ownedProjects           Project[]                     @relation("ProjectOwner")
  completedProjects       Project[]                     @relation("ProjectCompleter")
  projectMemberships      ProjectMember[]               @relation("ProjectMembership")
  projectStatusChanges    ProjectStatusHistory[]        @relation("ProjectStatusChangedBy")
  createdTasks            Task[]                        @relation("TaskCreatorMembership")
  taskAssignments         TaskAssignee[]                @relation("TaskAssignmentMembership")
  taskComments            TaskComment[]                 @relation("TaskCommentAuthorMembership")
  taskAttachments         TaskAttachment[]              @relation("TaskAttachmentCreatorMembership")
  taskActivities          TaskActivity[]                @relation("TaskActivityActorMembership")
  organizedMeetings       Meeting[]                     @relation("MeetingOrganizerMembership")
  meetingParticipations   MeetingParticipant[]          @relation("MeetingParticipantMembership")
  recordedMinutes         MeetingMinutes[]              @relation("MeetingMinutesRecorderMembership")
  publishedMinutes        MeetingMinutes[]              @relation("MeetingMinutesPublisherMembership")
  authoredWorkReports     WorkReport[]                  @relation("WorkReportAuthorMembership")
  reviewedWorkReports     WorkReport[]                  @relation("WorkReportReviewerMembership")
  requestedExpenseReports FinanceExpenseReport[]        @relation("FinanceExpenseRequester")
  reviewedExpenseReports  FinanceExpenseReport[]        @relation("FinanceExpenseReviewer")
  paidExpenseReports      FinanceExpenseReport[]        @relation("FinanceExpensePayer")
  financeStatusChanges    FinanceExpenseStatusHistory[] @relation("FinanceExpenseStatusActor")
  ownedLegalContracts     LegalContract[]                @relation("LegalContractOwner")
  legalStatusChanges      LegalContractStatusHistory[]   @relation("LegalContractStatusActor")
  dingTalkUserBindings    DingTalkUser[]
  hrProfile               HrProfile?
  hrLeaveBalances         HrLeaveBalance[]
  hrLeaveRequests         HrLeaveRequest[]
  hrAttendanceRecords     HrAttendanceRecord[]
  hrOvertimeRequests      HrOvertimeRequest[]
  hrEmployeeChanges       HrEmployeeChange[]
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")
  createdBy               String?                       @map("created_by") @db.Uuid
  updatedBy               String?                       @map("updated_by") @db.Uuid
  deletedAt               DateTime?                     @map("deleted_at")
  version                 Int                           @default(1)

  @@unique([tenantId, userId])
  @@unique([tenantId, normalizedAccount])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model AuthSession {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  userId           String           @map("user_id") @db.Uuid
  user             User             @relation(fields: [userId], references: [id])
  membershipId     String           @map("membership_id") @db.Uuid
  membership       TenantMembership @relation(fields: [membershipId], references: [id])
  refreshTokenHash String           @unique @map("refresh_token_hash")
  deviceName       String?          @map("device_name")
  ipAddress        String?          @map("ip_address")
  userAgent        String?          @map("user_agent")
  expiresAt        DateTime         @map("expires_at")
  lastUsedAt       DateTime?        @map("last_used_at")
  revokedAt        DateTime?        @map("revoked_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@index([tenantId, userId])
  @@index([tenantId, membershipId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PlatformAdministrator {
  id                String                      @id @default(uuid()) @db.Uuid
  userId            String                      @unique @map("user_id") @db.Uuid
  user              User                        @relation(fields: [userId], references: [id])
  account           String
  normalizedAccount String                      @unique @map("normalized_account")
  passwordHash      String                      @map("password_hash")
  role              PlatformRole                @default(SUPER_ADMIN)
  status            PlatformAdministratorStatus @default(ACTIVE)
  failedLoginCount  Int                         @default(0) @map("failed_login_count")
  lockedUntil       DateTime?                   @map("locked_until")
  lastLoginAt       DateTime?                   @map("last_login_at")
  sessions          PlatformAuthSession[]
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  createdBy         String?                     @map("created_by") @db.Uuid
  updatedBy         String?                     @map("updated_by") @db.Uuid
  deletedAt         DateTime?                   @map("deleted_at")
  version           Int                         @default(1)

  @@index([status, deletedAt])
  @@map("platform_administrators")
}

model PlatformAuthSession {
  id                      String                @id @default(uuid()) @db.Uuid
  platformAdministratorId String                @map("platform_administrator_id") @db.Uuid
  platformAdministrator   PlatformAdministrator @relation(fields: [platformAdministratorId], references: [id])
  userId                  String                @map("user_id") @db.Uuid
  user                    User                  @relation(fields: [userId], references: [id])
  refreshTokenHash        String                @unique @map("refresh_token_hash")
  deviceName              String?               @map("device_name")
  ipAddress               String?               @map("ip_address")
  userAgent               String?               @map("user_agent")
  expiresAt               DateTime              @map("expires_at")
  lastUsedAt              DateTime?             @map("last_used_at")
  revokedAt               DateTime?             @map("revoked_at")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")

  @@index([platformAdministratorId, revokedAt])
  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("platform_auth_sessions")
}

model Department {
  id                         String                 @id @default(uuid()) @db.Uuid
  tenantId                   String                 @map("tenant_id") @db.Uuid
  tenant                     Tenant                 @relation(fields: [tenantId], references: [id])
  parentId                   String?                @map("parent_id") @db.Uuid
  parent                     Department?            @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children                   Department[]           @relation("DepartmentHierarchy")
  name                       String
  normalizedName             String                 @map("normalized_name")
  description                String?
  sortOrder                  Int                    @default(0) @map("sort_order")
  status                     DepartmentStatus       @default(ACTIVE)
  memberships                TenantMembership[]
  projects                   Project[]
  meetings                   Meeting[]
  dingTalkDepartmentBindings DingTalkDepartment[]
  financeExpenseReports      FinanceExpenseReport[]
  financeExpenseItems        FinanceExpenseItem[]
  legalContracts             LegalContract[]
  createdAt                  DateTime               @default(now()) @map("created_at")
  updatedAt                  DateTime               @updatedAt @map("updated_at")
  createdBy                  String?                @map("created_by") @db.Uuid
  updatedBy                  String?                @map("updated_by") @db.Uuid
  deletedAt                  DateTime?              @map("deleted_at")
  version                    Int                    @default(1)

  @@index([tenantId, parentId])
  @@index([tenantId, status, sortOrder])
  @@map("departments")
}

model Role {
  id              String                 @id @default(uuid()) @db.Uuid
  tenantId        String                 @map("tenant_id") @db.Uuid
  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  code            String
  name            String
  description     String?
  isSystem        Boolean                @default(false) @map("is_system")
  dataScope       DataScope              @default(SELF) @map("data_scope")
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]
  invitationRoles TenantInvitationRole[]
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  createdBy       String?                @map("created_by") @db.Uuid
  updatedBy       String?                @map("updated_by") @db.Uuid
  deletedAt       DateTime?              @map("deleted_at")
  version         Int                    @default(1)

  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model TenantInvitation {
  id                     String                 @id @default(uuid()) @db.Uuid
  tenantId               String                 @map("tenant_id") @db.Uuid
  tenant                 Tenant                 @relation(fields: [tenantId], references: [id])
  account                String
  normalizedAccount      String                 @map("normalized_account")
  displayName            String                 @map("display_name")
  targetMembershipId     String?                @map("target_membership_id") @db.Uuid
  tokenHash              String                 @unique @map("token_hash")
  status                 TenantInvitationStatus @default(PENDING)
  isInitialAdministrator Boolean                @default(false) @map("is_initial_administrator")
  expiresAt              DateTime               @map("expires_at")
  acceptedAt             DateTime?              @map("accepted_at")
  acceptedByUserId       String?                @map("accepted_by_user_id") @db.Uuid
  acceptedByUser         User?                  @relation("AcceptedTenantInvitations", fields: [acceptedByUserId], references: [id])
  invitedByUserId        String                 @map("invited_by_user_id") @db.Uuid
  revokedAt              DateTime?              @map("revoked_at")
  roles                  TenantInvitationRole[]
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")

  @@index([tenantId, status, createdAt])
  @@index([tenantId, normalizedAccount, status])
  @@index([expiresAt])
  @@map("tenant_invitations")
}

model TenantInvitationRole {
  id           String           @id @default(uuid()) @db.Uuid
  invitationId String           @map("invitation_id") @db.Uuid
  invitation   TenantInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  roleId       String           @map("role_id") @db.Uuid
  role         Role             @relation(fields: [roleId], references: [id])
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([invitationId, roleId])
  @@index([roleId])
  @@map("tenant_invitation_roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  name            String
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("permissions")
}

model MembershipRole {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  membershipId String           @map("membership_id") @db.Uuid
  membership   TenantMembership @relation(fields: [membershipId], references: [id])
  roleId       String           @map("role_id") @db.Uuid
  role         Role             @relation(fields: [roleId], references: [id])
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
  @@map("membership_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([tenantId, roleId, permissionId])
  @@map("role_permissions")
}

model ResourceAcl {
  id              String         @id @default(uuid()) @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  resourceId      String         @map("resource_id") @db.Uuid
  resource        Resource       @relation(fields: [resourceId], references: [id])
  subjectType     AclSubjectType @map("subject_type")
  subjectId       String         @map("subject_id") @db.Uuid
  permissionCodes String[]       @map("permission_codes")
  expiresAt       DateTime?      @map("expires_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  createdBy       String?        @map("created_by") @db.Uuid
  updatedBy       String?        @map("updated_by") @db.Uuid
  deletedAt       DateTime?      @map("deleted_at")
  version         Int            @default(1)

  @@unique([tenantId, resourceId, subjectType, subjectId])
  @@index([tenantId, resourceId])
  @@index([tenantId, subjectType, subjectId])
  @@index([permissionCodes], type: Gin)
  @@map("resource_acls")
}

model Resource {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  type              ResourceType
  ownerMembershipId String           @map("owner_membership_id") @db.Uuid
  ownerMembership   TenantMembership @relation(fields: [ownerMembershipId], references: [id])
  document          ManagedDocument?
  image             ManagedImage?
  acls              ResourceAcl[]
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
