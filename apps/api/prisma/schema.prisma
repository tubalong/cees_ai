/// 服务端权威 AI 会话；归属创建成员，当前仅支持 PRIVATE 可见。
model Conversation {
  id                String                 @id @default(uuid()) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  ownerMembershipId String                 @map("owner_membership_id") @db.Uuid
  title             String                 @default("")
  visibility        ConversationVisibility @default(PRIVATE)
  /// 会话默认对话执行模式；发起轮次未显式指定时使用。
  mode              String                 @default("standard")
  lastTurnAt        DateTime?              @map("last_turn_at")
  /// 下一个轮次序号；事务内原子递增，避免 count+1 并发竞态。
  nextTurnSeq       Int                    @default(1) @map("next_turn_seq")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  deletedAt         DateTime?              @map("deleted_at")
  version           Int                    @default(1)

  messages  ConversationMessage[]
  summaries ConversationSummary[]
  turns     AssistantTurn[]

  @@index([tenantId, ownerMembershipId, updatedAt])
  @@map("conversations")
}

/// 服务端持久化的会话消息；USER/ASSISTANT 为对话正文，TOOL 为工具结果（工具阶段启用）。
model ConversationMessage {
  id             String                  @id @default(uuid()) @db.Uuid
  tenantId       String                  @map("tenant_id") @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  conversation   Conversation            @relation(fields: [conversationId], references: [id])
  turnId         String?                 @map("turn_id") @db.Uuid
  turn           AssistantTurn?          @relation("TurnMessages", fields: [turnId], references: [id])
  role           ConversationMessageRole
  content        String                  @db.Text
  /// 稳定的图片文件引用；模型请求前由 Assistant 动态解析为短期 URL。
  imageFileIds   String[]                @default([]) @map("image_file_ids")
  /// 稳定的文档文件引用；模型请求前由 Assistant 抽取文本注入上下文。
  documentFileIds String[]               @default([]) @map("document_file_ids")
  /// Desktop 从本地已授权连接器读取的本轮只读上下文；不作为业务事实或权限依据。
  connectorContexts Json                 @default("[]") @map("connector_contexts")
  /// TOOL 消息对应的工具调用 ID；其他角色为空，工具阶段启用。
  toolCallId     String?                 @unique @map("tool_call_id") @db.Uuid
  toolCall       ToolCall?               @relation("ToolCallMessage", fields: [toolCallId], references: [id])
  createdAt      DateTime                @default(now()) @map("created_at")

  @@index([tenantId, conversationId, createdAt])
  @@index([turnId])
  @@map("conversation_messages")
}

/// 服务端保存的历史摘要；由 Turn 编排在消息量超阈值时自动生成。
model ConversationSummary {
  id                         String       @id @default(uuid()) @db.Uuid
  tenantId                   String       @map("tenant_id") @db.Uuid
  conversationId             String       @map("conversation_id") @db.Uuid
  conversation               Conversation @relation(fields: [conversationId], references: [id])
  summary                    String       @db.Text
  summarizedThroughMessageId String?      @map("summarized_through_message_id") @db.Uuid
  createdAt                  DateTime     @default(now()) @map("created_at")

  @@index([tenantId, conversationId, createdAt])
  @@map("conversation_summaries")
}

/// 跨会话用户级长期记忆；归属租户内成员身份，仅本人可见、可查可删，AI 仅提议、NestJS 写入。
model UserMemory {
  id                   String     @id @default(uuid()) @db.Uuid
  tenantId             String     @map("tenant_id") @db.Uuid
  /// 归属成员身份而非全局用户：同一自然人在不同租户的记忆互相隔离，防止跨租户泄漏。
  membershipId         String     @map("membership_id") @db.Uuid
  type                 MemoryType
  content              String     @db.Text
  /// 来源会话与轮次，用于审计追溯；用户手动新增时为 null。
  sourceConversationId String?    @map("source_conversation_id") @db.Uuid
  sourceTurnId         String?    @map("source_turn_id") @db.Uuid
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  deletedAt            DateTime?  @map("deleted_at")
  version              Int        @default(1)

  @@index([tenantId, membershipId, deletedAt])
  @@map("user_memories")
}

/// 一轮完整 Assistant 运行；幂等键按会话去重，requestHash 防止同键不同内容重放。
model AssistantTurn {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  conversationId  String              @map("conversation_id") @db.Uuid
  conversation    Conversation        @relation(fields: [conversationId], references: [id])
  /// 会话内递增的轮次序号，从 1 开始。
  seq             Int
  idempotencyKey  String              @map("idempotency_key")
  /// 幂等键对应的请求内容哈希，重复提交同键不同内容时返回 409。
  requestHash     String              @map("request_hash")
  status          AssistantTurnStatus @default(RECEIVED)
  stage           AssistantTurnStage  @default(QUEUED)
  mode            String              @default("standard")
  /// 本轮是否允许检索知识库；开启后模型可获得知识库检索工具，范围按用户权限折叠。
  knowledgeBaseEnabled Boolean       @default(false) @map("knowledge_base_enabled")
  userId          String              @map("user_id") @db.Uuid
  membershipId    String              @map("membership_id") @db.Uuid
  requestId       String              @map("request_id")
  /// 事件与工具序号均由轮次行原子分配，避免 max/count+1 并发冲突。
  nextEventSeq    Int                 @default(1) @map("next_event_seq")
  nextToolCallSeq Int                 @default(1) @map("next_tool_call_seq")
  executionOwner  String?             @map("execution_owner")
  leaseExpiresAt  DateTime?           @map("lease_expires_at")
  heartbeatAt     DateTime?           @map("heartbeat_at")
  error           Json?
  /// 本轮最终答复附带的下一条追问建议（至多 3 条，随回答同次生成）；无追问时为 null。
  relatedQuestions Json?             @map("related_questions")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  completedAt     DateTime?           @map("completed_at")

  messages  ConversationMessage[] @relation("TurnMessages")
  events    AssistantEvent[]
  toolCalls ToolCall[]
  actionDrafts AssistantActionDraft[]

  @@unique([conversationId, idempotencyKey])
  @@unique([conversationId, seq])
  @@index([tenantId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("assistant_turns")
}

/// 带递增序号的轮次事件；断线重连按 (turnId, seq) 重放，payload 为公开事件 JSON。
model AssistantEvent {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @map("tenant_id") @db.Uuid
  turnId    String             @map("turn_id") @db.Uuid
  turn      AssistantTurn      @relation(fields: [turnId], references: [id], onDelete: Cascade)
  /// 轮次内递增事件序号，从 1 开始。
  seq       Int
  type      AssistantEventType
  payload   Json
  createdAt DateTime           @default(now()) @map("created_at")

  @@unique([turnId, seq])
  @@map("assistant_events")
}

/// 模型提出的工具调用：批准结论、执行结果与正式资源引用；回填 TOOL 消息时使用本表 ID。
model ToolCall {
  id                   String         @id @default(uuid()) @db.Uuid
  tenantId             String         @map("tenant_id") @db.Uuid
  conversationId       String         @map("conversation_id") @db.Uuid
  turnId               String         @map("turn_id") @db.Uuid
  turn                 AssistantTurn  @relation(fields: [turnId], references: [id], onDelete: Cascade)
  /// 轮次内工具调用序号，从 1 开始。
  seq                  Int
  /// 发起该工具调用的模型调用序号；同一模型调用内的多个工具共享该值。
  modelStep            Int            @default(1) @map("model_step")
  /// 上游模型返回的调用 ID；回填 ToolMessage.tool_call_id 时使用。
  upstreamCallId       String         @map("upstream_call_id")
  /// 同一模型回合中 assistant 在提出 tool_calls 前产生的正文；用于历史重建。
  assistantContent     String?        @map("assistant_content") @db.Text
  name                 String
  arguments            Json
  status               ToolCallStatus @default(PROPOSED)
  approvedAt           DateTime?      @map("approved_at")
  startedAt            DateTime?      @map("started_at")
  completedAt          DateTime?      @map("completed_at")
  executionToken       String?        @map("execution_token") @db.Uuid
  leaseExpiresAt       DateTime?      @map("lease_expires_at")
  /// 执行结果快照（只含稳定资源引用和摘要，不保存签名 URL）。
  result               Json?
  errorCode            String?        @map("error_code")
  errorMessage         String?        @map("error_message")
  executedResourceType String?        @map("executed_resource_type")
  executedResourceId   String?        @map("executed_resource_id") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  toolMessage       ConversationMessage? @relation("ToolCallMessage")
  generatedImage    ManagedImage?        @relation("GeneratedImageToolCall")
  generatedDocument ManagedDocument?     @relation("GeneratedDocumentToolCall")
  actionDraft       AIActionDraft?       @relation("ToolCallActionDraft")
  pendingActionDraft AssistantActionDraft? @relation("ToolCallPendingActionDraft")
  invocationLogs    AIInvocationLog[]    @relation("ToolCallInvocations")

  @@unique([turnId, seq])
  @@unique([turnId, modelStep, upstreamCallId])
  @@index([tenantId, createdAt])
  @@index([status, leaseExpiresAt])
  @@map("tool_calls")
}

model AIActionDraft {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @map("tenant_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  actionType           String      @map("action_type")
  payload              Json
  status               DraftStatus @default(DRAFT)
  expiresAt            DateTime?   @map("expires_at")
  /// 关联的工具调用 ID；AI 工具直接执行的动作用 request_id + tool_call_id 做幂等。
  toolCallId           String?     @unique @map("tool_call_id") @db.Uuid
  toolCall             ToolCall?   @relation("ToolCallActionDraft", fields: [toolCallId], references: [id])
  executedResourceType String?     @map("executed_resource_type")
  executedResourceId   String?     @map("executed_resource_id") @db.Uuid
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  createdBy            String?     @map("created_by") @db.Uuid
  updatedBy            String?     @map("updated_by") @db.Uuid
  deletedAt            DateTime?   @map("deleted_at")
  version              Int         @default(1)

  @@index([tenantId, userId, status])
  @@map("ai_action_drafts")
}

/// AI 写操作的待确认草稿（写操作确认机制的唯一事实源）。
///
/// 与 `AIActionDraft` 的分工：`AIActionDraft` 是「已执行动作流水」（生成图片/文档后以
/// EXECUTED 状态留痕，见 assistant-tool-loop.md 第 14 节）；本模型是「待用户确认的业务写
/// 草稿」——模型只产出参数与预览，**副作用不发生**，必须由用户在同一会话内确认后才执行。
/// 两者语义不同，不能合并，否则无法区分「已写」与「待写」。
///
/// 安全约束：
/// - `arguments` 是确认时唯一信任的参数快照，客户端确认只提交 draftId，不接受重新提交参数；
/// - 确认时重新解析成员实时权限并重新执行 `definition.validate`，参数与权限都不沿用创建时快照；
/// - `status` 的 PENDING_CONFIRMATION → EXECUTING 通过条件更新抢占，双击 / 重试不会重复执行；
/// - 过期草稿不可确认，只能重新发起对话让它重新生成。
model AssistantActionDraft {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  /// 产出该草稿的轮次；确认结果事件会追加回该轮次，保证重放与刷新后状态一致。
  turnId         String       @map("turn_id") @db.Uuid
  turn           AssistantTurn @relation(fields: [turnId], references: [id], onDelete: Cascade)
  membershipId   String       @map("membership_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  requestId      String       @map("request_id")
  /// 一比一对应产生草稿的工具调用；同时作为执行幂等键。
  toolCallId     String       @unique @map("tool_call_id") @db.Uuid
  toolCall       ToolCall     @relation("ToolCallPendingActionDraft", fields: [toolCallId], references: [id], onDelete: Cascade)
  toolName       String       @map("tool_name")
  toolVersion    String       @map("tool_version")
  riskLevel      String       @map("risk_level")
  /// 经 `definition.validate` 归一化后的参数快照。
  arguments      Json
  /// 面向用户的预览（标题 + 字段列表），由工具定义生成；不含内部 ID 与权限枚举。
  preview        Json
  status         DraftStatus  @default(PENDING_CONFIRMATION)
  expiresAt      DateTime     @map("expires_at")
  resolvedAt     DateTime?    @map("resolved_at")
  resolvedBy     String?      @map("resolved_by") @db.Uuid
  /// 执行成功后的结果摘要（回喂模型与展示用户的中文文案）。
  resultSummary  String?      @map("result_summary") @db.Text
  errorCode      String?      @map("error_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")
  version        Int          @default(1)

  @@index([tenantId, conversationId, status])
  @@index([status, expiresAt])
  @@map("assistant_action_drafts")
}

/// NestJS 发起 AI 调用后写入的模型执行指标；不保存对话正文、消息或摘要。
model AIInvocationLog {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// 发起调用时的租户成员身份快照；旧调用和非成员调用可为空。
  membershipId   String?   @map("membership_id") @db.Uuid
  /// 服务端会话标识（conversations 表）；仅 Chat/ToolTurn 类调用填写，不建外键以保留历史快照。
  conversationId String?   @map("conversation_id")
  /// 服务端轮次标识（assistant_turns 表）；同一轮内的压缩与多次模型调用共享该值。
  turnId         String?   @map("turn_id")
  requestId      String    @map("request_id")
  /// 工具执行对应的 ToolCall ID；图片生成等工具调用填写，配合 request_id 做幂等。
  toolCallId     String?   @map("tool_call_id") @db.Uuid
  toolCall       ToolCall? @relation("ToolCallInvocations", fields: [toolCallId], references: [id])
  traceId        String?   @map("trace_id")
  model          String
  latencyMs      Int       @map("latency_ms")
  inputTokens    Int?      @map("input_tokens")
  outputTokens   Int?      @map("output_tokens")
  operation      String
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([tenantId, requestId])
  @@index([tenantId, createdAt], map: "ai_invocation_logs_tenant_created_at_idx")
  @@index([tenantId, membershipId, createdAt], map: "ai_invocation_logs_member_created_at_idx")
  @@index([tenantId, membershipId, conversationId, turnId], map: "ai_invocation_logs_chat_turn_idx")
  @@map("ai_invocation_logs")
}

model AuditLog {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  actorUserId       String?      @map("actor_user_id") @db.Uuid
  actorMembershipId String?      @map("actor_membership_id") @db.Uuid
  action            String
  outcome           AuditOutcome @default(SUCCESS)
  resourceType      String       @map("resource_type")
  resourceId        String?      @map("resource_id") @db.Uuid
  requestId         String       @map("request_id")
  ipAddress         String?      @map("ip_address")
  userAgent         String?      @map("user_agent")
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at")

  @@index([tenantId, createdAt, id])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, outcome, createdAt])
  @@index([tenantId, actorMembershipId, createdAt])
  @@index([tenantId, requestId])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_logs")
}

model PlatformAuditLog {
  id                           String       @id @default(uuid()) @db.Uuid
  actorUserId                  String?      @map("actor_user_id") @db.Uuid
  actorPlatformAdministratorId String?      @map("actor_platform_administrator_id") @db.Uuid
  action                       String
  outcome                      AuditOutcome @default(SUCCESS)
