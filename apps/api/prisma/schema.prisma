generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum DataScope {
  SELF
  DEPARTMENT
  DEPARTMENT_TREE
  PROJECT
  CUSTOM
  TENANT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DraftStatus {
  DRAFT
  PENDING_CONFIRMATION
  CONFIRMED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

enum VisibilityScope {
  PRIVATE
  DEPARTMENT
  PROJECT
  TENANT
  CUSTOM
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  status TenantStatus @default(ACTIVE)
  memberships TenantMembership[]
  authSessions AuthSession[]
  departments Department[]
  roles Role[]
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@map("tenants")
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String
  normalizedEmail String @unique @map("normalized_email")
  passwordHash String @map("password_hash")
  displayName String @map("display_name")
  status UserStatus @default(ACTIVE)
  failedLoginCount Int @default(0) @map("failed_login_count")
  lockedUntil DateTime? @map("locked_until")
  lastLoginAt DateTime? @map("last_login_at")
  memberships TenantMembership[]
  authSessions AuthSession[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@map("users")
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id])
  departmentId String? @map("department_id") @db.Uuid
  department Department? @relation(fields: [departmentId], references: [id])
  displayName String? @map("display_name")
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now()) @map("joined_at")
  authSessions AuthSession[]
  membershipRoles MembershipRole[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@unique([tenantId, userId])
  @@index([tenantId, departmentId])
  @@index([tenantId, status])
  @@map("tenant_memberships")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  userId String @map("user_id") @db.Uuid
  user User @relation(fields: [userId], references: [id])
  membershipId String @map("membership_id") @db.Uuid
  membership TenantMembership @relation(fields: [membershipId], references: [id])
  refreshTokenHash String @unique @map("refresh_token_hash")
  deviceName String? @map("device_name")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  expiresAt DateTime @map("expires_at")
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@index([tenantId, userId])
  @@index([tenantId, membershipId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  parentId String? @map("parent_id") @db.Uuid
  name String
  memberships TenantMembership[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, parentId])
  @@map("departments")
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  code String
  name String
  description String?
  isSystem Boolean @default(false) @map("is_system")
  dataScope DataScope @default(SELF) @map("data_scope")
  membershipRoles MembershipRole[]
  rolePermissions RolePermission[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@unique([tenantId, code])
  @@index([tenantId, deletedAt])
  @@map("roles")
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  name String
  rolePermissions RolePermission[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("permissions")
}

model MembershipRole {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  membershipId String @map("membership_id") @db.Uuid
  membership TenantMembership @relation(fields: [membershipId], references: [id])
  roleId String @map("role_id") @db.Uuid
  role Role @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, membershipId, roleId])
  @@index([tenantId, membershipId])
  @@map("membership_roles")
}

model RolePermission {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  roleId String @map("role_id") @db.Uuid
  role Role @relation(fields: [roleId], references: [id])
  permissionId String @map("permission_id") @db.Uuid
  permission Permission @relation(fields: [permissionId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, roleId, permissionId])
  @@map("role_permissions")
}

model ResourceAcl {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  resourceType String @map("resource_type")
  resourceId String @map("resource_id") @db.Uuid
  subjectType String @map("subject_type")
  subjectId String @map("subject_id") @db.Uuid
  permission String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, resourceType, resourceId])
  @@map("resource_acls")
}

model Project {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  name String
  description String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, departmentId])
  @@map("projects")
}

model ProjectMember {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  projectId String @map("project_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role String @default("MEMBER")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, projectId, userId])
  @@index([tenantId, userId])
  @@map("project_members")
}

model Task {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  title String
  description String?
  status TaskStatus @default(TODO)
  priority TaskPriority @default(MEDIUM)
  dueDate DateTime? @map("due_date")
  relationType String? @map("relation_type")
  relationId String? @map("relation_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, status, dueDate])
  @@index([tenantId, projectId])
  @@map("tasks")
}

model TaskAssignee {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  assigneeType String @default("OWNER") @map("assignee_type")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, taskId, userId])
  @@index([tenantId, userId])
  @@map("task_assignees")
}

model TaskComment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid
  content String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid
  fileObjectId String @map("file_object_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, taskId])
  @@map("task_attachments")
}

model TaskActivity {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  taskId String @map("task_id") @db.Uuid
  action String
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String? @map("created_by") @db.Uuid
  @@index([tenantId, taskId])
  @@map("task_activities")
}

model WorkReport {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  reportType String @map("report_type")
  reportDate DateTime @map("report_date")
  content Json
  sourceDraftId String? @map("source_draft_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, userId, reportDate])
  @@map("work_reports")
}

model FileObject {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  objectKey String @map("object_key")
  mimeType String @map("mime_type")
  sizeBytes BigInt @map("size_bytes")
  checksum String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId])
  @@map("file_objects")
}

model KnowledgeBase {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  name String
  description String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId])
  @@map("knowledge_bases")
}

model KnowledgeBaseMember {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  knowledgeBaseId String @map("knowledge_base_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  permission String
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, knowledgeBaseId, userId])
  @@map("knowledge_base_members")
}

model Document {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  knowledgeBaseId String @map("knowledge_base_id") @db.Uuid
  fileObjectId String @map("file_object_id") @db.Uuid
  name String
  status String @default("PENDING")
  departmentId String? @map("department_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, knowledgeBaseId])
  @@map("documents")
}

model DocumentVersion {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  fileObjectId String @map("file_object_id") @db.Uuid
  versionNumber Int @map("version_number")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String? @map("created_by") @db.Uuid
  @@unique([tenantId, documentId, versionNumber])
  @@map("document_versions")
}

model DocumentChunk {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  knowledgeBaseId String @map("knowledge_base_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  projectId String? @map("project_id") @db.Uuid
  visibilityScope VisibilityScope @map("visibility_scope")
  content String @db.Text
  embedding Unsupported("vector")
  metadata Json
  chunkIndex Int @map("chunk_index")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, knowledgeBaseId, documentId])
  @@map("document_chunks")
}

model KnowledgeQueryLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  query String
  answer String?
  citations Json?
  requestId String @map("request_id")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId, userId, createdAt])
  @@map("knowledge_query_logs")
}

model Meeting {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  title String
  startsAt DateTime @map("starts_at")
  durationMinutes Int @map("duration_minutes")
  departmentId String? @map("department_id") @db.Uuid
  agenda Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, startsAt])
  @@map("meetings")
}

model MeetingParticipant {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  meetingId String @map("meeting_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  status String @default("INVITED")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, meetingId, userId])
  @@map("meeting_participants")
}

model MeetingMinutes {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  meetingId String @map("meeting_id") @db.Uuid
  content Json
  status String @default("DRAFT")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, meetingId])
  @@map("meeting_minutes")
}

model Notification {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  title String
  content String
  channel String @default("IN_APP")
  relationType String? @map("relation_type")
  relationId String? @map("relation_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationRecipient {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  notificationId String @map("notification_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  readAt DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([tenantId, notificationId, userId])
  @@map("notification_recipients")
}

model AIActionDraft {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  actionType String @map("action_type")
  payload Json
  status DraftStatus @default(DRAFT)
  expiresAt DateTime? @map("expires_at")
  executedResourceType String? @map("executed_resource_type")
  executedResourceId String? @map("executed_resource_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String? @map("created_by") @db.Uuid
  updatedBy String? @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  version Int @default(1)
  @@index([tenantId, userId, status])
  @@map("ai_action_drafts")
}

model AIInvocationLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  requestId String @map("request_id")
  traceId String? @map("trace_id")
  model String
  latencyMs Int @map("latency_ms")
  inputTokens Int? @map("input_tokens")
  outputTokens Int? @map("output_tokens")
  operation String
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId, requestId])
  @@map("ai_invocation_logs")
}

model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorMembershipId String? @map("actor_membership_id") @db.Uuid
  action String
  outcome AuditOutcome @default(SUCCESS)
  resourceType String @map("resource_type")
  resourceId String? @map("resource_id") @db.Uuid
  requestId String @map("request_id")
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")
  metadata Json?
  createdAt DateTime @default(now()) @map("created_at")
  @@index([tenantId, createdAt, id])
  @@index([tenantId, action, createdAt])
  @@index([tenantId, outcome, createdAt])
  @@index([tenantId, actorMembershipId, createdAt])
  @@index([tenantId, requestId])
  @@index([tenantId, resourceType, resourceId])
  @@map("audit_logs")
}
