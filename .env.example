NODE_ENV=development

POSTGRES_DB=cees_ai_dev
POSTGRES_USER=cees_dev
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://cees_dev:change_me@localhost:5432/cees_ai_dev?schema=public
DINGTALK_API_BASE_URL=https://oapi.dingtalk.com
DINGTALK_CREDENTIAL_ENCRYPTION_KEY=change_me

REDIS_PASSWORD=change_me
REDIS_PORT=6379
REDIS_URL=redis://:change_me@localhost:6379/0
REDIS_KEY_PREFIX=cees:local:

# 腾讯云 COS：Bucket 名称格式通常为 <bucket-name>-<appid>。
# 生产环境请使用仅授予目标 Bucket 必要权限的 CAM 子账号或角色凭据。
TENCENT_COS_SECRET_ID=change_me
TENCENT_COS_SECRET_KEY=change_me
TENCENT_COS_REGION=ap-chengdu
TENCENT_COS_BUCKET=cees-ai-1403013862
TENCENT_COS_OBJECT_PREFIX=cees/local
TENCENT_COS_SIGNED_URL_TTL_SECONDS=600
TENCENT_COS_UPLOAD_MAX_BYTES=104857600

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_PLATFORM_ACCESS_SECRET=change_me
JWT_PLATFORM_ACCESS_TTL=15m
JWT_PLATFORM_REFRESH_TTL=30d
TENANT_INVITATION_TTL=1d

# 仅本地完整 prisma:seed 使用，不参与 Staging/Production 自动初始化。
SEED_TENANT_CODE=cees
SEED_TENANT_NAME=CEES
SEED_ADMIN_ACCOUNT=admin
SEED_ADMIN_PASSWORD=change_me
SEED_ADMIN_DISPLAY_NAME=Administrator

# 本地完整 seed 与部署专用 seed-platform-admin 共用；已有同名账号时不会覆盖。
SEED_PLATFORM_ADMIN_ACCOUNT=superadmin
SEED_PLATFORM_ADMIN_PASSWORD=change_me
SEED_PLATFORM_ADMIN_DISPLAY_NAME=Platform Administrator

# 联网搜索：当前仅支持 Tavily；实际密钥通过平台 Secrets 注入。
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=change_me
WEB_SEARCH_TIMEOUT_MS=10000
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_SNIPPET_CHARS=1500

AI_SERVICE_URL=http://localhost:8000
AI_INTERNAL_TOKEN=change_me
AI_DOCS_ENABLED=true

AI_MODEL_CONFIG_PATH=config/models.toml
PRIMARY_LLM_API_KEY=change_me
BACKUP_LLM_API_KEY=change_me
IMAGE_GEN_API_KEY=change_me
IMAGE_GEN_BACKUP_API_KEY=change_me
VISION_LLM_API_KEY=change_me
EMBEDDING_API_KEY=change_me

# 知识库向量库：memory 为进程内实现（开发/测试），pgvector 为独立数据库。
# pgvector 模式要求同一 PostgreSQL 实例存在 cees_ai_vectors 库，且维度与
# 配置的 embedding 模型一致。
KNOWLEDGE_VECTOR_STORE=memory
KNOWLEDGE_VECTOR_DATABASE_URL=postgresql://cees_dev:change_me@localhost:5432/cees_ai_vectors
KNOWLEDGE_VECTOR_DIMENSION=384

# NestJS 知识文档索引 Worker：关闭后仍可经 kick() 即时触发（默认开启）。
KNOWLEDGE_INDEXING_ENABLED=true
KNOWLEDGE_INDEXING_INTERVAL_SECONDS=15
KNOWLEDGE_INDEX_MAX_RETRIES=3
# 索引请求三元组（chunking / embedding profile / index 版本），
# 与 ai-service 的 embedding profile 配置保持一致。
KNOWLEDGE_CHUNKING_VERSION=knowledge-chunking-v1
KNOWLEDGE_EMBEDDING_PROFILE=deterministic
KNOWLEDGE_INDEX_VERSION=knowledge-index-v1

# MinerU 文档解析服务（FastAPI）。未配置时解析器抛 MINERU_NOT_CONFIGURED，
# 文档直接置 FAILED；配置后 Worker 从 COS 下载原始文件并同步调用 /file_parse。
# MINERU_API_URL=http://192.168.5.29:8002
# MINERU_API_TIMEOUT_MS=1800000
# MINERU_API_LANG_LIST=ch

API_PORT=3000
AI_SERVICE_PORT=8000
DESKTOP_API_URL=http://localhost:3000/api/v1
MOBILE_API_URL=http://localhost:3000/api/v1
