# DB_BIND_IP 必须是本机网卡上已分配的地址，通常是私网 IP（见 ip -4 addr show）。
# 云厂商公网 IP/EIP 经 NAT 映射，未配置在网卡上，Docker 绑定会报 cannot assign requested address。
# 也可以填 0.0.0.0，但必须用防火墙或安全组限制来源并拒绝公网访问。
DB_BIND_IP=change_me

POSTGRES_DB=cees_ai_staging
POSTGRES_USER=cees_staging
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

REDIS_PASSWORD=change_me
REDIS_PORT=6379
